# Text files use LF in the repository and in every checkout.
* text=auto eol=lf

# Byte-sensitive fixtures must remain identical on Windows and Linux.
# -text prevents Git from rewriting BOMs, CRLF or UTF-16 test inputs.
testdata/contracts/cases/*.ass -text
# This CRLF/BOM sample is binary evidence; no text diff whitespace checks.
testdata/contracts/cases/utf8bom.ass binary

# Snapshot comparisons use exact bytes produced by encoding/json.
testdata/contracts/golden/*.json text eol=lf
internal/fontreport/testdata/*.golden text eol=lf

# Raw benchstat input is line-oriented and platform-neutral.
docs/development/baseline-*.txt text eol=lf

# Renderer evidence and its generated representation are shared across OSes.
docs/reference/ass-tags.xml text eol=lf
internal/ass/renderer/*_generated.go text eol=lf
